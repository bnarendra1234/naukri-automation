# Naukri Credentials
NAUKRI_EMAIL=your_email@example.com
NAUKRI_PASSWORD=your_naukri_password

# Execution Mode (HEADLESS=False opens visible browser for debugging/first-time OTP)
HEADLESS=False

# Run Profile Booster (updates profile daily to rank higher in recruiter searches)
UPDATE_PROFILE=True

# Maximum jobs to apply per daily run (recommended: 20-30 to avoid rate limits)
MAX_APPLICATIONS_PER_RUN=25

# Scheduled Time (IST)
SCHEDULE_TIME=08:30
TIMEZONE=Asia/Kolkata
